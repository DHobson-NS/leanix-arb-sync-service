# Copy to .env (gitignored) and fill in. Used by openshift/deploy.sh.

LEANIX_HOST=norfolksouthern.leanix.net
LEANIX_API_TOKEN=            # LeanIX technical user token (Sandbox workspace)
# ARB_LEANIX_HOST=           # only if arb-sync uses another workspace than LEANIX_HOST
# ARB_LEANIX_API_TOKEN=      # only if arb-sync uses another token than LEANIX_API_TOKEN

ARB_API_TOKEN=               # the token callers (the management service) must send to this service
MANAGEMENT_API_TOKEN=        # the token of the management service, to read the configuration

# ── Database: leanix_arb, user arb_user, on the PostgreSQL server of the leanix-services platform ──
ARB_DB_PASSWORD=
